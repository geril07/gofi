+/// The font files fontconfig knows, including ones outside the standard directories (NixOS's
+/// store paths); empty where fontconfig isn't used. [`system_font_files`] runs it only when the
+/// directories have none of the files.
+#[cfg(all(unix, not(target_vendor = "apple"), not(target_os = "android")))]
+fn fontconfig_files() -> &'static [(String, std::path::PathBuf)] {
+    static FILES: std::sync::OnceLock<Vec<(String, std::path::PathBuf)>> = std::sync::OnceLock::new();
+    FILES.get_or_init(|| {
+        let Ok(out) = std::process::Command::new("fc-list").arg("--format=%{file}\n").output() else { return Vec::new() };
+        let mut found = Vec::new();
+        for path in String::from_utf8_lossy(&out.stdout).lines().map(std::path::PathBuf::from) {
+            if let Some(name) = font_file_name(&path) { found.push((name, path)); }
+        }
+        found
+    })
+}
+
+#[cfg(not(all(unix, not(target_vendor = "apple"), not(target_os = "android"))))]
